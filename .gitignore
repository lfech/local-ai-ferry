# Python environments and build output
__pycache__/
*.py[co]
*.egg-info/
.venv/
.venv-before-install-*/
/python-package/build/
/python-package/dist/
# Release builds add the standalone executable to the package data of their own copy.
/python-package/src/loaf/data/standalone/
/dist/
/loaf

# Installer cache and launcher state
/install-cache/
/docker-project
.run.lock
/.loaf-terminal-runtime/
.test-artifacts/

# Environment overrides and terminal credentials
.env
.env.*
.test-*
!.env.example
terminal-server.key
/config/**/*.key

# Deployment backups and model exports
/backup/
local-ai-ferry.tar.gz
*_local-ai-ferry.tar.gz
*_local-ai-ferry-[0-9]*.tar.gz
*_local-ai-ferry/
*_local-ai-ferry-[0-9]*/

# Generated test APT repository
/apt-test-repository/
/config/apt-test-repository.list

# Other agent related config files
CLAUDE.md
# Release message
release.md
