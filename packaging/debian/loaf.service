[Unit]
Description=Local AI Ferry offline deployment
Documentation=man:loaf(1)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=/var/lib/loaf
ExecStart=/usr/bin/loaf --system run offline --attach
ExecStop=/usr/bin/loaf --system stop
StandardOutput=null
StandardError=journal
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
